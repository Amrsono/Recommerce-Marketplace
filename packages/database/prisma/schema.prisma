generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("") // Temporarily default for existing; will be mandatory for new
  name      String?
  role      Role     @default(CUSTOMER)
  trustScore      Int             @default(100)
  devices         Device[]
  tickets         Ticket[]
  messagesSent    Message[]       @relation("SentMessages")
  messagesReceived Message[]      @relation("ReceivedMessages")
  paymentMethods  PaymentMethod[]
  notifications   Notification[]
  bids            Bid[]           @relation("VendorBids")
  wonTickets      Ticket[]        @relation("WinningVendor")
  listings        MarketListing[] @relation("SellerListings")
  customerBids    CustomerBid[]   @relation("CustomerBids")
  orders          Order[]         @relation("BuyerOrders")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Device {
  id          String   @id @default(uuid())
  brand       String
  model       String
  specs       Json
  condition   String   // e.g., "Mint", "Good", "Poor", "Complex"
  estimatedVal Float?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ticket      Ticket?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id           String       @id @default(uuid())
  status       TicketStatus @default(OPEN)
  slaDeadline  DateTime
  deviceId     String       @unique
  device       Device       @relation(fields: [deviceId], references: [id])
  customerId   String
  customer     User         @relation(fields: [customerId], references: [id])
  engineerId   String?      // Assigned engineer for mandatory visits
  isUrgent     Boolean      @default(false)
  scheduledVisit DateTime?  // Admin proposed date/time
  visitStatus  VisitStatus? @default(PENDING)
  messages     Message[]
  bids         Bid[]
  winningVendorId String?
  winningVendor   User?     @relation("WinningVendor", fields: [winningVendorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum VisitStatus {
  PENDING
  APPROVED
  REJECTED
}

model Message {
  id        String   @id @default(uuid())
  content   String
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // e.g., "CARD", "PAYPAL", "BANK_TRANSFER"
  last4     String?  // Last 4 digits for UI display
  provider  String?  // e.g., "Stripe", "PayPal"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String   // MESSAGE, TICKET_UPDATE, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  CUSTOMER
  ENGINEER
  ADMIN
  VENDOR
}

enum TicketStatus {
  OPEN
  PRICING_ESTIMATED
  ENGINEER_VISIT_SCHEDULED
  STORE_VISIT_SCHEDULED
  RESOLVED
  REJECTED
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Bid {
  id        String   @id @default(uuid())
  amount    Float
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  vendorId  String
  vendor    User     @relation("VendorBids", fields: [vendorId], references: [id])
  status    BidStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceCatalog {
  id          String   @id @default(uuid())
  make        String
  model       String
  storage     String
  @@unique([make, model, storage])
}

model MarketListing {
  id          String   @id @default(uuid())
  title       String
  description String
  basePrice   Float
  currentBid  Float?
  condition   String
  make        String
  model       String
  storage     String
  images      Json?
  sellerId    String
  seller      User     @relation("SellerListings", fields: [sellerId], references: [id])
  status      String   @default("AVAILABLE") // AVAILABLE, SOLD, CANCELLED
  bids        CustomerBid[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerBid {
  id          String   @id @default(uuid())
  amount      Float
  listingId   String
  listing     MarketListing @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User          @relation("CustomerBids", fields: [buyerId], references: [id])
  status      String        @default("PENDING") // PENDING, WINNING, REJECTED, WON
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Order {
  id           String   @id @default(uuid())
  listingId    String
  listing      MarketListing @relation(fields: [listingId], references: [id])
  buyerId      String
  buyer        User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  status       String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED
  totalAmount  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

